// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // WAJIB untuk Cloudflare Workers: client default meng-embed query compiler
  // sebagai base64 dan mengompilasinya saat runtime via `new WebAssembly.Module()`,
  // yang DILARANG workerd ("Wasm code generation disallowed by embedder") —
  // semua query Prisma gagal di Worker (terbukti di preview 13 Nov 2026).
  // Dengan runtime="workerd", generator menyalin query_compiler_fast_bg.wasm
  // asli ke output dan client mengimpornya sebagai modul precompiled.
  // Konsekuensi: client ini TIDAK bisa dieksekusi di Node — semua halaman yang
  // memakai Prisma WAJIB `dynamic = "force-dynamic"` (sudah) dan tidak boleh
  // ada generateStaticParams yang menyentuh DB saat build (sudah dihapus).
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String               @id @default(uuid())
  productId      String               @unique
  sortOrder      Int                  @default(0)
  projectName    String               @default("")
  image          String?
  urlPreview     String?
  githubUrl      String?
  figmaUrl       String?
  internal       Boolean              @default(false)
  // Tech detail fields
  techStack      String? // e.g. "React, Next.js, Tailwind CSS"
  deployment     String? // e.g. "Vercel, Netlify"
  server         String? // e.g. "Node.js, Express"
  designMethod   String? // e.g. "Figma, Adobe XD" or "AI Agent: ChatGPT, Claude"
  orm            String? // e.g. "Prisma, Drizzle"
  database       String? // e.g. "PostgreSQL, MongoDB"
  domainProvider String? // e.g. "Cloudflare, Namecheap"
  categories     Category[]           @relation("ProjectCategories")
  skills         Skill[]              @relation("ProjectSkills")
  translations   ProjectTranslation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model ProjectTranslation {
  id          String  @id @default(uuid())
  locale      String
  description String
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[] @relation("ProjectCategories")
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[] @relation("ProjectSkills")
}

model Message {
  id        String    @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SkillItem {
  id        String   @id @default(uuid())
  name      String
  image     String
  bgColor   String   @default("#28A9E0")
  textColor String   @default("#28A9E0")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkExperience {
  id          String   @id @default(uuid())
  company     String
  position    String
  location    String?
  type        String   @default("Full-time")
  startDate   String
  endDate     String   @default("Present")
  description String?
  logo        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id            String   @id @default(uuid())
  name          String
  organization  String
  issueDate     String?
  expiryDate    String?
  credentialUrl String?
  logo          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EducationItem {
  id          String   @id @default(uuid())
  school      String
  degree      String
  field       String
  startDate   String
  endDate     String
  description String?
  logo        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SectionText {
  id        String   @id @default(uuid())
  section   String // "skills" | "works" | "certificates" | "education"
  key       String // "title" | "description" | "experience_label"
  locale    String // "id" | "en" | "" (global)
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key, locale])
}

model CvFile {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(uuid())
  section   String // e.g., "banner", "about", "skills", "contact", "navbar"
  key       String // e.g., "greeting", "description", "email"
  locale    String   @default("") // "id", "en", or "" for non-localized
  value     String // text or JSON for complex data
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key, locale])
}
